ml_filename=str(source/'maps/test_room.yaml'),use_sim_time=True)\n    config['planner_server']['ros__parameters']['use_sim_time']=True\n    config['global_costmap']['global_costmap']['ros__parameters']['use_sim_time']=True\n    effective=out/'effective.yaml';effective.write_text(yaml.safe_dump(config))\n    rclpy.init(args=['--ros-args','-r','/valdi/keepout_filter_mask:=/oomwoo/keepout_mask','-r','/valdi/keepout_costmap_filter_info:=/oomwoo/keepout_filter_info'])\n    node=Observer();node.set_parameters([Parameter('use_sim_time',value=True)])\n    q=QoSProfile(depth=1,reliability=QoSReliabilityPolicy.RELIABLE,durability=QoSDurabilityPolicy.TRANSIENT_LOCAL)\n    masks=node.create_publisher(OccupancyGrid,'/oomwoo/keepout_mask',q)\n    infos=node.create_publisher(CostmapFilterInfo,'/oomwoo/keepout_filter_info',q)\n    tf=node.create_publisher(TFMessage,'/tf_static',q)\n    clocks=node.create_publisher(Clock,'/clock',10)\n    meta=yaml.safe_load((out/'keepout_test_room.yaml').read_text());w,h,pixels=_pgm(out/meta['image'])\n    mask=OccupancyGrid();mask.header.frame_id='map';mask.header.stamp.sec=1\n    mask.info.width=w;mask.info.height=h;mask.info.resolution=meta['resolution']\n    mask.info.origin.position.x,mask.info.origin.position.y=meta['origin'][:2]\n    mask.info.origin.orientation.w=1.;mask.data=[100 if pixels[row*w+col]==0 else 0 for row in reversed(range(h)) for col in range(w)]\n    assert list(mask.data).count(100)==count==220\n    masks.publish(mask)\n    info=CostmapFilterInfo();info.type=0;info.filter_mask_topic='/oomwoo/keepout_mask';info.base=0.;info.multiplier=1.;infos.publish(info)\n    start=(-0.22217017330367905, -2.6064883256596816)\n    goal=(4.725000094249845, -2.52499999217689)\n    transform=TransformStamped();transform.header.frame_id='map';transform.child_frame_id='base_link';transform.header.stamp.sec=1\n    transform.transform.translation.x,transform.transform.translation.y=start;transform.transform.rotation.w=1.\n    tf.publish(TFMessage(transforms=[transform]))\n    processes=[Node(package='nav2_map_server',executable='map_server',name='map_server',parameters=[str(effective)],output='screen'),Node(package='nav2_planner',executable='planner_server',name='planner_server',parameters=[str(effective)],output='screen')]\n    exits=[]\n    handlers=[RegisterEventHandler(OnProcessExit(target_action=p,on_exit=lambda event,context:exits.append(event.returncode) or [])) for p in processes]\n    launch=LaunchService();launch.include_launch_description(LaunchDescription(processes+handlers));task=asyncio.create_task(launch.run_async())\n    wall=time.monotonic();result={'ok':False,'scope':'Actual installed Navfn and production Keepout overlay; static original map/mask and declared synthetic map->base TF/clock, no scan/Gazebo/controller/motor. Start-only counterfactual: live costmap TF stays fixed at estimated pose; no historical scan/costmap retained. Result ok means diagnostic executed/closed, not both goals succeeded.','start_xy':list(start),'goal_xy':list(goal),'overlay_forbidden_cells':count,'synthetic_tf_yaw':0.,'effective_configuration':config['global_costmap']['global_costmap']['ros__parameters'],'cases':{}}\n    async def until(pred,seconds):\n        end=time.monotonic()+seconds\n        while time.monotonic()<end:\n            if task.done():raise RuntimeError('owned launch stopped before completing observation')\n            ns=2_000_000_000+int((time.monotonic()-wall)/.02)*20_000_000\n            clock=Clock();clock.clock.sec=ns//1_000_000_000;clock.clock.nanosec=ns%1_000_000_000;clocks.publish(clock)\n            rclpy.spin_once(node,timeout_sec=0.)\n            if pred():return\n            await asyncio.sleep(.01)\n        raise RuntimeError('observation stage timeout')\n    async def transition(name,ident):\n        client=node.create_client(ChangeState,'/'+name+'/change_state');await until(client.service_is_ready,15)\n        request=ChangeState.Request();request.transition.id=ident\n        f=client.call_async(request);await until(f.done,15);assert f.result().success,(name,ident)\n    async def params(name,names):\n        client=node.create_client(GetParameters,'/'+name+'/get_parameters');await until(client.service_is_ready,8)\n        req=GetParameters.Request();req.names=names;f=client.call_async(req);await until(f.done,8)\n        return {n:{'type':v.type,'double':v.double_value,'bool':v.bool_value,'string':v.string_value,'strings':list(v.string_array_value)} for n,v in zip(names,f.result().values)}\n    try:\n        for ident in (1,3):await transition('map_server',ident)\n        await until(lambda:node.base_map is not None,10)\n        for ident in (1,3):await transition('planner_server',ident)\n        await until(lambda:node.global_grid is not None and node.global_grid.data[cell(node.global_grid,.85,0.)]>=95 and node.planner.server_is_ready(),15)\n        result['effective_parameters']={'planner':await params('planner_server',['GridBased.plugin','GridBased.tolerance','GridBased.use_astar','GridBased.allow_unknown','use_sim_time']),'costmap':await params('global_costmap/global_costmap',['filters','robot_radius','keepout_inflation.inflation_radius','keepout_inflation.cost_scaling_factor','use_sim_time'])}\n        audit=Raster.from_ros(mask)\n        result['mask_geometry']={'width':w,'height':h,'resolution':audit.resolution,'origin_x':audit.origin_x,'origin_y':audit.origin_y,'data_sha256':hashlib.sha256(bytes(audit.data)).hexdigest()}\n        for key,a,z in [('estimated_start_same_stamp',start,goal),('truth_start_same_stamp',(-0.271995383488593, -2.497323823926928),goal)]:\n            req=ComputePathToPose.Goal();req.start=node.pose(*a);req.goal=node.pose(*z);req.use_start=True;req.planner_id='GridBased'\n            sent=node.planner.send_goal_async(req);await until(sent.done,12);handle=sent.result();assert handle.accepted\n            completed=handle.get_result_async();await until(completed.done,20);reply=completed.result();planned=reply.result\n            points=[(p.pose.position.x,p.pose.position.y) for p in planned.path.poses]\n            if reply.status!=4 or planned.error_code!=0 or len(points)<2:\n                result['cases'][key]={'status':reply.status,'error_code':planned.error_code,'error_msg':planned.error_msg,'points_xy_m':points}\n                continue\n            clear={str(radius):all(swept_disk_clear(audit,x,y,radius,0) for x,y in zip(points,points[1:])) for radius in (.18,.24)}\n            invalid=[i for i,(x,y) in enumerate(zip(points,points[1:])) if not swept_disk_clear(audit,x,y,.24,0)]\n            result['cases'][key]={'status':reply.status,'error_code':planned.error_code,'path_frame':planned.path.header.frame_id,'path_stamp_ns':planned.path.header.stamp.sec*1_000_000_000+planned.path.header.stamp.nanosec,'points_xy_m':points,'path_length_m':sum(math.dist(x,y) for x,y in zip(points,points[1:])),'swept_disk_clear':clear,'nonclear_24cm_segment_indices':invalid,'straight_link_24cm_clear':swept_disk_clear(audit,a,z,.24,0)}\n        assert len(result['cases'])==2\n        result['ok']=True\n    except Exception as exc:result['error']=repr(exc)\n    finally:\n        closed=launch.shutdown()\n        if inspect.isawaitable(closed):await closed\n        try:await asyncio.wait_for(task,timeout=15)\n        except Exception as exc:result['cleanup_error']=repr(exc);result['ok']=False\n        result['process_exit_codes']=exits\n        if sorted(exits)!=[0,0]:result['ok']=False\n        result['seconds']=round(time.monotonic()-wall,3)\n        result['cgroup']={str(p):p.read_text() for p in [Path('/sys/fs/cgroup/memory.peak'),Path('/sys/fs/cgroup/memory.events'),Path('/sys/fs/cgroup/pids.peak')] if p.exists()}\n        node.destroy_node();rclpy.shutdown()\n        print('NAV2_PATH_CONTRACT_RESULT '+json.dumps(result),flush=True)\n    return 0 if result['ok'] else 1\nraise SystemExit(asyncio.run(main()))\n\nCASE\n"
