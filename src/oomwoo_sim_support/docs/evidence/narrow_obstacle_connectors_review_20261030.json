  "fixture_python": "\nimport json\nfrom pathlib import Path\nfrom types import SimpleNamespace,MethodType\nimport numpy as np,yaml\nfrom nav_msgs.msg import OccupancyGrid\nfrom oomwoo_coverage.coverage_planner_node import CoveragePlanner\nfrom oomwoo_sim_support.keepout_config import _pgm\nroot=Path('/work/src/oomwoo_sim_support');m=yaml.safe_load((root/'maps/test_room.yaml').read_text())\nw,h,p=_pgm(root/'maps/test_room.pgm')\npix=np.flipud(np.frombuffer(p,dtype=np.uint8).reshape(h,w))\nocc=(255-pix.astype(float))/255\ngrid=np.where(occ>m['occupied_thresh'],100,np.where(occ<m['free_thresh'],0,-1))\ng=OccupancyGrid();g.header.frame_id='map';g.info.width=w;g.info.height=h\ng.info.resolution=m['resolution'];g.info.origin.position.x=m['origin'][0];g.info.origin.position.y=m['origin'][1];g.info.origin.orientation.w=1.\ng.data=grid.reshape(-1).astype(int).tolist()\nmask=OccupancyGrid();mask.header=g.header;mask.info=g.info;mask.data=[0]*(w*h)\nfor row in range(h):\n for col in range(w):\n  x=m['origin'][0]+(col+.5)*m['resolution'];y=m['origin'][1]+(row+.5)*m['resolution']\n  if .67<=x<=1.14 and -.55<=y<=.55:mask.data[row*w+col]=100\n\nimport math,heapq,hashlib,time\nfrom oomwoo_coverage.coverage_planner_node import _flood_fill,_nearest_true\nnode=SimpleNamespace(map_msg=g,keepout=None,_keepout_geometry_value=None,_keepout_fault=None,_keepout_required=True,_relay_enabled=True,robot_radius=.18,total_free_cells=0,free_mask=None,robot_xy=(0.,0.))\nnode._keepout_geometry=CoveragePlanner._keepout_geometry\nnode._invalid_keepout=lambda message:(_ for _ in ()).throw(ValueError(message))\nnode._build_masks=MethodType(CoveragePlanner._build_masks,node)\nCoveragePlanner._on_keepout(node,mask)\nres=g.info.resolution;ox=g.info.origin.position.x;oy=g.info.origin.position.y\nseed_xy=(0.,0.);seed=_nearest_true(node.free_mask,int((0-ox)/res),int((0-oy)/res))\nallowed=_flood_fill(node.free_mask,seed)\nbase=Path('/work/src/oomwoo_sim_support/docs/evidence')\np0=base/'narrow_local_caps_rev