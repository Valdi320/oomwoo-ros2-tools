nt('TF_POSTDATE_CONTENT_RESULT '+json.dumps({'ok':True,'scope':'Actual installed tf2 Buffer; synthetic declared ramp/constant corrections and odometry. No native AMCL/Gazebo/DDS or historical source reconstruction.','cases':cases}),flush=True)\n\nCASE\n"
